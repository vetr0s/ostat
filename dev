#!/usr/bin/env bash
# Build the example site and serve it.
#
#   ./dev            build with drafts, serve on :1313
#   ./dev --build    production build only, no server
#   ./dev --clean    throw away public/ first, then serve
#
# There is no file watcher. Rebuild with ctrl-c and rerun, or run
# `./dev --build` from the editor while the server keeps running.
set -euo pipefail

cd "$(dirname "$0")"

SITE="site"
OUT="public"
PORT="${PORT:-1313}"

# site/static/resume.pdf is not committed. vetr0s/resume owns it and that repo
# is private, so there is no anonymous URL to curl: it needs an authenticated
# gh. Anyone without access simply does not get the file, and the demo's
# /resume.pdf link 404s locally, which is not worth a warning on every run.
if [ ! -f "$SITE/static/resume.pdf" ] && command -v gh > /dev/null; then
  tmp="$(mktemp)"
  if gh api repos/vetr0s/resume/contents/resume.pdf --jq .content 2>/dev/null \
      | base64 --decode > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv "$tmp" "$SITE/static/resume.pdf"
  else
    rm -f "$tmp"
  fi
fi

./build.sh debug

case "${1:-}" in
  --build)
    rm -rf "$OUT"
    ./build/debug/ostat build "$SITE" -o "$OUT"
    echo
    echo "Built to $OUT/. This is what a deploy would publish."
    ;;
  *)
    if [ "${1:-}" = "--clean" ]; then
      rm -rf "$OUT"
    fi

    ./build/debug/ostat build "$SITE" -o "$OUT" -drafts -future
    echo
    echo "serving $OUT/ on http://localhost:$PORT"
    exec python3 -m http.server "$PORT" --directory "$OUT"
    ;;
esac
